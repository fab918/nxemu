<rml>
 <head><title>Shader profile</title><link type="text/rcss" href="base.rcss" /></head>
 <body class="dialog-backdrop">
  <div class="dialog" style="width: 560dp; max-width: 90vw;">
   <div class="dialog-header"><div id="profile-title" class="dialog-title">Shader profile</div><div class="dialog-close" data-command="close">&#xD7;</div></div>
   <div style="padding: 24dp;">
    <div id="profile-game" style="font-size: 18dp; margin-bottom: 16dp;" />
    <div id="profile-detail" style="margin-bottom: 16dp;" />
    <div style="height: 6dp; background-color: #dddddd; margin-bottom: 12dp; overflow: hidden;">
     <div id="profile-progress-fill" style="height: 6dp; width: 0%; background-color: #1764df;" />
    </div>
    <div id="profile-status" />
   </div>
   <div class="dialog-footer"><button data-command="close">Cancel</button><button id="profile-start" class="primary" data-command="start">Choose file</button></div>
  </div>
 </body>
</rml>
