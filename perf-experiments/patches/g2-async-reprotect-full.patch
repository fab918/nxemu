+#ifdef _WIN32
+
+namespace {
+
+struct CorePlacement {
+    // CPU set id of the first logical processor of each reserved core, by DedicatedThread.
+    std::vector<ULONG> reserved;
+    // CPU set ids the other threads of the process may use.
+    std::vector<ULONG> shared;
+};
+
+// NXEMU_CPU_PLACEMENT selects how many threads get a core: "off", "gpu" (GPU thread),
+// "gpu1" (GPU thread and guest core 0), "full" (GPU thread and the 4 guest cores).
+size_t ReservedThreadCount() {
+    char value[16]{};
+    size_t length = 0;
+    if (getenv_s(&length, value, sizeof(value), "NXEMU_CPU_PLACEMENT") != 0 || length == 0) {
+        return 0;
+    }
+    const std::string mode{value};
+    if (mode == "gpu") {
+        return 1;
+    }
+    if (mode == "gpu1") {
+        return 2;
+    }
+    if (mode == "full" || mode == "toggle") {
+        return 5;
+    }
+    return 0;
+}
+
+// Test mode: placement is on during even 5 second slots of the steady clock and off during odd
+// ones, so a single run compares both on nearly the same scene.
+bool PlacementToggles() {
+    char value[16]{};
+    size_t length = 0;
+    return getenv_s(&length, value, sizeof(value), "NXEMU_CPU_PLACEMENT") == 0 &&
+           std::string{value} == "toggle";
+}
+
+struct PlacedThread {
+    HANDLE handle;
+    ULONG id;
+};
+std::mutex placed_mutex;
+std::vector<PlacedThread> placed_threads;
+
+CorePlacement BuildPlacement() {
+    CorePlacement placement;
+    const size_t wanted = ReservedThreadCount();
+    if (wanted == 0) {
+        return placement;
+    }
+    ULONG length = 0;
+    GetSystemCpuSetInformation(nullptr, 0, &length, GetCurrentProcess(), 0);
+    std::vector<u8> buffer(length);
+    auto* const first = reinterpret_cast<SYSTEM_CPU_SET_INFORMATION*>(buffer.data());
+    if (length == 0 || !GetSystemCpuSetInformation(first, length, &length, GetCurrentProcess(), 0)) {
+        return placement;
+    }
+    struct Core {
+        WORD group;
+        BYTE core_index;
+        BYTE efficiency;
+        std::vector<std::pair<BYTE, ULONG>> logical; // logical processor index, cpu set id
+    };
+    std::vector<Core> cores;
+    for (size_t offset = 0; offset < length;) {
+        const auto* const info =
+            reinterpret_cast<const SYSTEM_CPU_SET_INFORMATION*>(buffer.data() + offset);
+        offset += info->Size;
+        if (info->Type != CpuSetInformation || info->CpuSet.Parked) {
+            continue;
+        }
+        const auto& set = info->CpuSet;
+        auto it = std::find_if(cores.begin(), cores.end(), [&](const Core& core) {
+            return core.group == set.Group && core.core_index == set.CoreIndex;
+        });
+        if (it == cores.end()) {
+            cores.push_back(Core{set.Group, set.CoreIndex, set.EfficiencyClass, {}});
+            it = cores.end() - 1;
+        }
+        it->logical.emplace_back(set.LogicalProcessorIndex, set.Id);
+    }
+    // Keep at least two cores for the rest of the process (Vulkan worker, timing, audio,
+    // shader compilation and the UI).
+    if (cores.size() < wanted + 2) {
+        return placement;
+    }
+    // Fastest cores first. Among equal cores take the last ones: core 0 also serves most
+    // interrupts.
+    std::sort(cores.begin(), cores.end(), [](const Core& a, const Core& b) {
+        if (a.efficiency != b.efficiency) {
+            return a.efficiency > b.efficiency;
+        }
+        if (a.group != b.group) {
+            return a.group > b.group;
+        }
+        return a.core_index > b.core_index;
+    });
+    for (auto& core : cores) {
+        std::sort(core.logical.begin(), core.logical.end());
+    }
+    for (size_t index = 0; index < cores.size(); ++index) {
+        if (index < wanted) {
+            placement.reserved.push_back(cores[index].logical.front().second);
+            continue;
+        }
+        for (const auto& logical : cores[index].logical) {
+            placement.shared.push_back(logical.second);
+        }
+    }
+    return placement;
+}
+
+const CorePlacement& GetPlacement() {
+    static const CorePlacement placement = [] {
+        CorePlacement result = BuildPlacement();
+        if (!result.reserved.empty()) {
+            // Threads without a CPU set of their own stay off the reserved cores, including
+            // their second SMT thread.
+            SetProcessDefaultCpuSets(GetCurrentProcess(), result.shared.data(),
+                                     static_cast<ULONG>(result.shared.size()));
+        }
+        if (!result.reserved.empty() && PlacementToggles()) {
+            std::thread([shared = result.shared] {
+                bool applied = true;
+                for (;;) {
+                    const auto now = std::chrono::steady_clock::now().time_since_epoch();
+                    const bool on =
+                        (std::chrono::duration_cast<std::chrono::seconds>(now).count() / 5) % 2 == 0;
+                    if (on != applied) {
+                        applied = on;
+                        SetProcessDefaultCpuSets(GetCurrentProcess(), on ? shared.data() : nullptr,
+                                                 on ? static_cast<ULONG>(shared.size()) : 0);
+                        std::scoped_lock lock{placed_mutex};
+                        for (PlacedThread& placed : placed_threads) {
+                            SetThreadSelectedCpuSets(placed.handle, on ? &placed.id : nullptr,
+                                                     on ? 1 : 0);
+                        }
+                    }
+                    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+                }
+            }).detach();
+        }
+        return result;
+    }();
+    return placement;
+}
+
+} // Anonymous namespace
+
+void PlaceCurrentThread(DedicatedThread thread) {
+    const CorePlacement& placement = GetPlacement();
+    const size_t index = static_cast<size_t>(thread);
+    if (index >= placement.reserved.size()) {
+        return;
+    }
+    ULONG id = placement.reserved[index];
+    SetThreadSelectedCpuSets(GetCurrentThread(), &id, 1);
+    if (PlacementToggles()) {
+        HANDLE handle{};
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &handle,
+                        THREAD_SET_LIMITED_INFORMATION | THREAD_QUERY_LIMITED_INFORMATION, FALSE, 0);
+        std::scoped_lock lock{placed_mutex};
+        placed_threads.push_back(PlacedThread{handle, id});
+    }
+}
+
+#else
+
+void PlaceCurrentThread(DedicatedThread) {}
+
+#endif
+
