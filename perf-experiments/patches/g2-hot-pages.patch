+    // Pages re-protected by an upload that the CPU writes again: count the cycles
+    void CountRewrites(size_t index, u64 unprotected) noexcept {
+        if (!IsShort() || unprotected == 0) {
+            return;
+        }
+        const u64 rewritten = unprotected & reprotected_words[index];
+        reprotected_words[index] &= ~unprotected;
+        IteratePages(rewritten, [&](size_t offset, size_t count) {
+            for (size_t page = offset; page < offset + count; ++page) {
+                u8& streak = rewrite_streak[index * PAGES_PER_WORD + page];
+                streak = static_cast<u8>(std::min<u32>(streak + 1U, 255U));
+            }
+        });
+    }
+
+    // Returns the pages of an upload that stay writable. Pages rewritten after each of their
+    // last uploads become hot here. Pages the GPU wrote stay protected.
+    u64 HotPagesToKeep(size_t index, u64 mask, u64 modified, u64 untracked) noexcept {
+        if (!IsShort() || !HotPagesEnabled()) {
+            return 0;
+        }
+        const u64 gpu = Array<Type::GPU>()[index];
+        const u64 candidates = mask & modified & untracked & ~hot_words[index] & ~gpu;
+        u64 promoted = 0;
+        IteratePages(candidates, [&](size_t offset, size_t count) {
+            for (size_t page = offset; page < offset + count; ++page) {
+                if (rewrite_streak[index * PAGES_PER_WORD + page] >= HOT_REWRITES) {
+                    promoted |= u64{1} << page;
+                }
+            }
+        });
+        if (promoted != 0) {
+            hot_words[index] |= promoted;
+            has_hot_pages = true;
+        }
+        const u64 keep = mask & untracked & hot_words[index];
+        // The others are protected again now
+        reprotected_words[index] |= mask & untracked & ~keep;
+        return keep;
+    }
+
+    // The GPU writes hot pages: protect them again so GPU writes stay visible
+    void DemoteForGpuWrite(size_t index, u64 mask) noexcept {
+        if (!IsShort()) {
+            return;
+        }
+        const u64 pages = hot_words[index] & mask;
+        if (pages == 0) {
+            return;
+        }
+        hot_words[index] &= ~pages;
+        // A hot page counts as CPU modified at each epoch even when the CPU did not write it,
+        // which would hide what the GPU writes now. The GPU data is the newer one.
+        u64* const untracked_words = Array<Type::Untracked>();
+        NotifyRasterizer<true>(index, untracked_words[index], pages);
+        untracked_words[index] &= ~pages;
+        Array<Type::CPU>()[index] &= ~pages;
+        reprotected_words[index] &= ~pages;
+        IteratePages(pages, [&](size_t offset, size_t count) {
+            std::fill_n(rewrite_streak.begin() + index * PAGES_PER_WORD + offset, count, u8{0});
+        });
+        UpdateCpuWorkWord(index);
+    }
+
+    // TEMP A/B: NXEMU_HOT_PAGES=0 keeps protection based tracking for every page
+    static bool HotPagesEnabled() {
+        static const bool enabled = [] {
+            const char* value = std::getenv("NXEMU_HOT_PAGES");
+            return value == nullptr || value[0] != '0';
+        }();
+        return enabled;
+    }
