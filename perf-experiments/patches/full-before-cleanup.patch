new file mode 100644
index 0000000000..53db6b73d8
--- /dev/null
+++ b/src/yuzu_common/frame_trace.h
@@ -0,0 +1,176 @@
+// TEMP: frame timeline tracer for the bottleneck study. Not for commit.
+//
+// NXEMU_TRACE_DIR=<folder> enables it. NXEMU_TRACE_START_UNIX_MS and NXEMU_TRACE_SECONDS set the
+// window. Each module writes its own Chrome trace JSON when the window ends; timestamps share
+// the steady clock so the files can be merged.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace FrameTrace {
+
+struct Event {
+    const char* name;
+    std::int64_t begin_ns;
+    std::int64_t end_ns; // equal to begin_ns for instant events
+    std::uint64_t arg;
+};
+
+struct ThreadBuffer {
+    std::size_t tid{};
+    std::vector<Event> events;
+    std::atomic<std::size_t> count{0};
+};
+
+struct Registry {
+    bool enabled{};
+    std::int64_t window_begin{};
+    std::int64_t window_end{};
+    std::string path;
+    std::mutex mutex;
+    std::vector<std::unique_ptr<ThreadBuffer>> buffers;
+    std::atomic<bool> dumped{false};
+};
+
+inline std::int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+inline void Init(Registry& r) {
+    {
+        const char* dir = std::getenv("NXEMU_TRACE_DIR");
+        const char* start = std::getenv("NXEMU_TRACE_START_UNIX_MS");
+        if (dir == nullptr || start == nullptr) {
+            return;
+        }
+        const char* seconds = std::getenv("NXEMU_TRACE_SECONDS");
+        const double duration_s = seconds ? std::atof(seconds) : 3.0;
+        const std::int64_t sys_now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                            std::chrono::system_clock::now().time_since_epoch())
+                                            .count();
+        const std::int64_t steady_now = Now();
+        r.window_begin = steady_now + (std::atoll(start) - sys_now_ms) * 1000000LL;
+        r.window_end = r.window_begin + static_cast<std::int64_t>(duration_s * 1e9);
+        r.path = std::string(dir) + "/trace-" +
+                 std::to_string(reinterpret_cast<std::uintptr_t>(&r)) + ".json";
+        r.enabled = true;
+    }
+}
+
+inline Registry& GetRegistry() {
+    static Registry registry;
+    static const bool initialized = (Init(registry), true);
+    (void)initialized;
+    return registry;
+}
+
+inline void Dump(Registry& r) {
+    if (r.dumped.exchange(true)) {
+        return;
+    }
+    std::scoped_lock lock{r.mutex};
+    FILE* f = std::fopen(r.path.c_str(), "w");
+    if (f == nullptr) {
+        return;
+    }
+    std::fprintf(f, "{\"traceEvents\":[\n");
+    bool first = true;
+    for (const auto& buffer : r.buffers) {
+        const std::size_t n = buffer->count.load(std::memory_order_acquire);
+        for (std::size_t i = 0; i < n; ++i) {
+            const Event& e = buffer->events[i];
+            std::fprintf(f, "%s{\"name\":\"%s\",\"ph\":\"%s\",\"ts\":%.3f,%s\"pid\":1,\"tid\":%zu,"
+                            "\"args\":{\"a\":%llu}}\n",
+                         first ? "" : ",", e.name, e.end_ns == e.begin_ns ? "i" : "X",
+                         e.begin_ns / 1000.0,
+                         e.end_ns == e.begin_ns
+                             ? "\"s\":\"t\","
+                             : (std::string("\"dur\":") +
+                                std::to_string((e.end_ns - e.begin_ns) / 1000.0) + ",")
+                                   .c_str(),
+                         buffer->tid, static_cast<unsigned long long>(e.arg));
+            first = false;
+        }
+    }
+    std::fprintf(f, "]}\n");
+    std::fclose(f);
+}
+
+inline ThreadBuffer* GetBuffer(Registry& r) {
+    thread_local ThreadBuffer* buffer = [&] {
+        auto owned = std::make_unique<ThreadBuffer>();
+        owned->tid = std::hash<std::thread::id>{}(std::this_thread::get_id()) & 0xFFFFFF;
+        owned->events.resize(1 << 20);
+        ThreadBuffer* raw = owned.get();
+        std::scoped_lock lock{r.mutex};
+        r.buffers.push_back(std::move(owned));
+        return raw;
+    }();
+    return buffer;
+}
+
+inline void Record(const char* name, std::int64_t begin, std::int64_t end, std::uint64_t arg) {
+    Registry& r = GetRegistry();
+    if (!r.enabled || end < r.window_begin) {
+        return;
+    }
+    if (begin > r.window_end) {
+        Dump(r);
+        return;
+    }
+    ThreadBuffer* buffer = GetBuffer(r);
+    const std::size_t n = buffer->count.load(std::memory_order_relaxed);
+    if (n >= buffer->events.size()) {
+        return;
+    }
+    buffer->events[n] = Event{name, begin, end, arg};
