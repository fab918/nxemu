+template <typename Traits>
+thread_local typename DeviceMemoryManager<Traits>::DeferredCaching* DeviceMemoryManager<Traits>::deferred_caching = nullptr;
+
+template <typename Traits>
+void DeviceMemoryManager<Traits>::ApplyDeferredCaching(DAddr addr, size_t size)
+{
+    // Same lock as UpdatePagesCachedCount: the protection follows the count as it is now,
+    // whatever happened to it since the protection was deferred.
+    Common::ScopedRangeLock lk(counter_guard, addr, size);
+    const auto MarkRegionCaching = &DeviceMemoryManager<Traits>::DeviceMethods::MarkRegionCaching;
+    std::atomic_thread_fence(std::memory_order_acquire);
+    IMemory* memory = nullptr;
+    Asid current_asid{};
+    u64 begin = 0;
+    u64 bytes = 0;
+    const auto flush = [&] {
+        if (bytes > 0 && memory != nullptr)
+        {
+            MarkRegionCaching(memory, begin << DEVICE_PAGEBITS, bytes, true);
+        }
+        bytes = 0;
+    };
+    const size_t page_end = Common::DivCeil(addr + size, DEVICE_PAGESIZE);
+    for (size_t page = addr >> DEVICE_PAGEBITS; page != page_end; ++page)
+    {
+        const CounterAtomicType& count = cached_pages->at(page >> subentries_shift).Count(page);
+        auto [asid, vpage] = ExtractCPUBacking(page);
+        vpage >>= DEVICE_PAGEBITS;
+        if (vpage == 0 || count.load(std::memory_order_relaxed) == 0)
+        {
+            flush();
+            continue;
+        }
+        if (bytes == 0 || asid.id != current_asid.id || vpage != begin + bytes / DEVICE_PAGESIZE)
+        {
+            flush();
+            current_asid = asid;
+            memory = GetRegisteredProcess(asid);
+            begin = vpage;
+        }
+        bytes += DEVICE_PAGESIZE;
+    }
+    flush();
+}
