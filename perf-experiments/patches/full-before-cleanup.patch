+    endif()
+    if(NXEMU_PGO STREQUAL "GENERATE")
+        add_link_options("$<$<CONFIG:Release>:/GENPROFILE>")
+    elseif(NXEMU_PGO STREQUAL "USE")
+        add_link_options("$<$<CONFIG:Release>:/USEPROFILE>")
+    else()
+        message(FATAL_ERROR "NXEMU_PGO must be OFF, GENERATE or USE")
+    endif()
+    message(STATUS "PGO: ${NXEMU_PGO} in Release")
+endif()
