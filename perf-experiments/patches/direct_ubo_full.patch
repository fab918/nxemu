+    /// Whether the emulated GPU ever wrote one of the pages of a range
+    [[nodiscard]] bool AreGpuWrittenPages(DAddr address, size_t size) const noexcept {
+        if (size == 0) {
+            return false;
+        }
+        const size_t last = (address + size - 1) >> page_bits;
+        for (size_t page = address >> page_bits; page <= last; ++page) {
+            if (gpu_written_pages[page / 64].load(std::memory_order_relaxed) &
+                (1ULL << (page % 64))) {
+                return true;
+            }
+        }
+        return false;
+    }
