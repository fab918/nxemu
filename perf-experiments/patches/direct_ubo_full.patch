+BufferCacheRuntime::~BufferCacheRuntime() {
+    const auto& dld = device.GetDispatchLoader();
+    const VkDevice logical = *device.GetLogical();
+    for (const GuestMemoryChunk& chunk : guest_chunks) {
+        if (chunk.buffer != VK_NULL_HANDLE) {
+            dld.vkDestroyBuffer(logical, chunk.buffer, nullptr);
+        }
+        if (chunk.memory != VK_NULL_HANDLE) {
+            dld.vkFreeMemory(logical, chunk.memory, nullptr);
+        }
+    }
+}
+
+void BufferCacheRuntime::SetGuestMemory(uintptr_t base, size_t size) {
+    if (!device.IsExtExternalMemoryHostSupported() || base % 4096 != 0 || size == 0) {
+        return;
+    }
+    guest_memory_base = base;
+    guest_memory_size = size;
+    guest_chunks.resize(Common::DivCeil(size, GUEST_CHUNK_SIZE));
+    uniform_buffer_alignment = device.GetUniformBufferAlignment();
+}
+
+bool BufferCacheRuntime::BindGuestUniformBuffer(const u8* host_pointer, u32 size) {
+    const uintptr_t offset = reinterpret_cast<uintptr_t>(host_pointer) - guest_memory_base;
+    const size_t index = offset >> GUEST_CHUNK_BITS;
+    if (guest_chunks.empty() || size == 0 || offset >= guest_memory_size ||
+        offset % uniform_buffer_alignment != 0 || ((offset + size - 1) >> GUEST_CHUNK_BITS) != index) {
+        return false;
+    }
+    VkBuffer buffer = guest_chunks[index].buffer;
+    if (buffer == VK_NULL_HANDLE) {
+        buffer = ImportGuestChunk(index);
+        if (buffer == VK_NULL_HANDLE) {
+            return false;
+        }
+    }
+    BindBuffer(buffer, static_cast<u32>(offset & (GUEST_CHUNK_SIZE - 1)), size);
+    return true;
+}
+
+VkBuffer BufferCacheRuntime::ImportGuestChunk(size_t index) {
+    GuestMemoryChunk& chunk = guest_chunks[index];
+    if (chunk.failed) {
+        return VK_NULL_HANDLE;
+    }
+    chunk.failed = true;
+    const auto& dld = device.GetDispatchLoader();
+    const VkDevice logical = *device.GetLogical();
+    void* const pointer = reinterpret_cast<void*>(guest_memory_base + (index << GUEST_CHUNK_BITS));
+    const VkDeviceSize size =
+        std::min<VkDeviceSize>(GUEST_CHUNK_SIZE, guest_memory_size - (index << GUEST_CHUNK_BITS));
+
+    VkMemoryHostPointerPropertiesEXT host_properties{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+        .pNext = nullptr,
+        .memoryTypeBits = 0,
+    };
+    if (dld.vkGetMemoryHostPointerPropertiesEXT(
+            logical, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, pointer,
+            &host_properties) != VK_SUCCESS) {
+        LOG_WARNING(Render_Vulkan, "Guest memory cannot be imported, uniform buffers are copied");
+        return VK_NULL_HANDLE;
+    }
+    const VkExternalMemoryBufferCreateInfo external_info{
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+        .pNext = nullptr,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+    };
+    const VkBufferCreateInfo buffer_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .pNext = &external_info,
+        .flags = 0,
+        .size = size,
+        .usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                 VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+                 VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+    };
+    VkBuffer buffer = VK_NULL_HANDLE;
+    if (dld.vkCreateBuffer(logical, &buffer_ci, nullptr, &buffer) != VK_SUCCESS) {
+        return VK_NULL_HANDLE;
+    }
+    const VkMemoryRequirements requirements = device.GetLogical().GetBufferMemoryRequirements(buffer);
+    const u32 type_bits = requirements.memoryTypeBits & host_properties.memoryTypeBits;
+    if (type_bits == 0) {
+        dld.vkDestroyBuffer(logical, buffer, nullptr);
+        return VK_NULL_HANDLE;
+    }
+    const VkImportMemoryHostPointerInfoEXT import_info{
+        .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+        .pNext = nullptr,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+        .pHostPointer = pointer,
+    };
+    const VkMemoryAllocateInfo allocate_info{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = &import_info,
+        .allocationSize = size,
+        .memoryTypeIndex = static_cast<u32>(std::countr_zero(type_bits)),
+    };
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    if (dld.vkAllocateMemory(logical, &allocate_info, nullptr, &memory) != VK_SUCCESS ||
+        dld.vkBindBufferMemory(logical, buffer, memory, 0) != VK_SUCCESS) {
+        if (memory != VK_NULL_HANDLE) {
+            dld.vkFreeMemory(logical, memory, nullptr);
+        }
+        dld.vkDestroyBuffer(logical, buffer, nullptr);
+        LOG_WARNING(Render_Vulkan, "Failed to import guest memory chunk {}", index);
+        return VK_NULL_HANDLE;
+    }
+    chunk = {.memory = memory, .buffer = buffer, .failed = false};
+    return buffer;
+}
