+bool StagingBufferPool::KeepStreamRangeAlive(u64 generation, VkDeviceSize offset, size_t size) {
+    if (generation != stream_generation) {
+        return false;
+    }
+    // Memory of this generation is only handed out again after a wrap, once the regions'
