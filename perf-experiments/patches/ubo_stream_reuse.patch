+    /// Like BindMappedUniformBuffer, also returns where the data went so it can be bound again
+    std::span<u8> BindReusableUniformBuffer(u32 size, u64& offset, u64& generation) {
+        const StagingBufferRef ref = staging_pool.Request(size, MemoryUsage::Upload);
+        BindBuffer(ref.buffer, static_cast<u32>(ref.offset), size);
+        offset = ref.offset;
+        generation = ref.buffer == staging_pool.StreamBuf() ? staging_pool.StreamGeneration()
+                                                            : ~0ULL;
+        return ref.mapped_span;
+    }
+
+    const u8* temp_rewrite = nullptr; // TEMP
+    bool TempCheck(u64 offset, u64 generation, const u8* data, u32 size) { // TEMP
+        if (generation != staging_pool.StreamGeneration()) return true;
+        return std::memcmp(staging_pool.TempStreamSpan().data() + offset, data, size) == 0;
+    }
+    /// Binds data uploaded earlier by BindReusableUniformBuffer, if it is still there
+    bool RebindUniformBuffer(u64 offset, u64 generation, u32 size) {
+        if (!staging_pool.KeepStreamRangeAlive(generation, offset, size)) {
+            return false;
+        }
+        BindBuffer(staging_pool.StreamBuf(), static_cast<u32>(offset), size);
+        if (temp_rewrite) std::memcpy(staging_pool.TempStreamSpan().data() + offset, temp_rewrite, size); // TEMP
+        return true;
+    }
