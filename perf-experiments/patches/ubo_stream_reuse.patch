+    const u64 current_tick = scheduler.CurrentTick();
+    const size_t last_region = Region(offset + size - 1);
+    for (size_t region = Region(offset); region <= last_region; ++region) {
+        sync_ticks[region] = std::max(sync_ticks[region], current_tick);
+    }
+    return true;
