 #ifdef __linux__
@@ -79,6 +80,54 @@ void PerfMapClear() {
 
 }  // namespace Dynarmic::Backend::X64
 
+#elif defined(_WIN32)
+
+// TEMP: block map for profiling, written when NXEMU_PERF_MAP_DIR is set
+#    include <cstdio>
+#    include <cstdlib>
+#    include <mutex>
+#    include <process.h>
+
+namespace Dynarmic::Backend::X64 {
+
+namespace {
+std::mutex mutex;
+std::FILE* file = nullptr;
+bool tried = false;
+}  // anonymous namespace
+
+namespace detail {
+void PerfMapRegister(const void* start, const void* end, std::string_view friendly_name) {
+    if (start == end) {
+        return;
+    }
+    std::lock_guard guard{mutex};
+    if (!tried) {
+        tried = true;
+        if (const char* dir = std::getenv("NXEMU_PERF_MAP_DIR")) {
+            char name[512];
+            std::snprintf(name, sizeof(name), "%s/perf-%d.map", dir, _getpid());
+            file = std::fopen(name, "w");
+        }
+    }
+    if (!file) {
+        return;
+    }
+    std::fprintf(file, "%016llx %llx %.*s\n", (unsigned long long)(uintptr_t)start,
+                 (unsigned long long)((const char*)end - (const char*)start),
+                 (int)friendly_name.size(), friendly_name.data());
+}
+}  // namespace detail
+
+void PerfMapClear() {
+    std::lock_guard guard{mutex};
+    if (file) {
+        std::fflush(file);
+    }
+}
+
+}  // namespace Dynarmic::Backend::X64
+
 #else
 
 namespace Dynarmic::Backend::X64 {
